# ─── Secrets — never commit ───────────────────────────────────────────────────
secrets.yaml
secrets.yml
.env
.env.*
*.key
*.pem

# ─── Firmware images & backups — large, device-specific, may embed credentials ─
*.bin
*.uf2
*.hex
*_backup*
*-backup*
backups/
# …but this is our own tool, not a backup artifact. The rule above is meant to
# catch dumped firmware and credential blobs; the script itself is safe to ship.
!ha-integration/aidot-key-backup.py

# ─── Matter / commissioning material — device-identifying, never publish ──────
# Setup codes, QR payloads and DACs are per-device secrets: anyone with the code
# can commission the bulb onto their own fabric.
setup-codes*
*-qr.png
*.chip
pairing-codes*

# ─── Local-only source material ───────────────────────────────────────────────
# research/  — live agent scratch notes; contain the real IoT SSID + LAN addressing.
#              Findings are synthesized into README.md (scrubbed) instead.
# prior-art/ — vendored upstream clones (their own git repos), not ours to ship.
research/
prior-art/

# ─── Never vendor third-party integration code ────────────────────────────────
# A local copy of sulibot/hass-AiDot is useful for reading and testing, but must
# not be redistributed here: it would ship someone else's code under this repo's
# LICENSE, and pin users to a stale fork with no update path. Reference upstream
# via HACS instead — see ha-integration/README.md.
ha-integration/custom_components/

# ─── ESPHome build artifacts ──────────────────────────────────────────────────
.esphome/
.esphome*/

# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Editor / OS cruft ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
.vscode/
